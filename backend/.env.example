# Copy this file to ".env" (setup.bat does it for you), then paste your own key.
# Get a free key at https://aistudio.google.com/apikey  (never share it or commit it)
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE

# Text model used by the AI tutor. Must be available on the free tier for your account.
# Checked against https://ai.google.dev/gemini-api/docs/pricing on 14 Oct 2026.
# Free-tier text options: gemini-3.8-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-2.5-flash
GEMINI_MODEL=gemini-3.8-flash

PORT=5000
